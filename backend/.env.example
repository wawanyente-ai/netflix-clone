# Environment
ENV=development
PORT=8080
LOG_LEVEL=debug

# Google Cloud / Firebase
GCP_PROJECT_ID=netflix-clone
# Optional; uses Application Default Credentials when empty.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# TMDB proxy (Fase 7; server-side key, never exposed to iOS)
TMDB_ACCESS_TOKEN=

# Dev only: allow requests without a valid Firebase ID token.
# MUST stay false in production.
ALLOW_UNAUTHENTICATED_DEV=false

# Comma-separated CORS origins for web/testing clients.
CORS_ALLOWED_ORIGINS=http://localhost:3000